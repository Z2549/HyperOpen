<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="图标来源包名（留空则自动解析）"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_icon_package"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如 com.tencent.mm"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="内置符号 key（包名无效时作为兜底）"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_icon_glyph"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="scan / flashlight / camera / calc / note"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="图标预览"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_preview"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="可用 key：scan、flashlight、camera、calc、note、mic、music、settings、bus、wallet、sparkle\n留空则按名称自动匹配符号"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>
</ScrollView>
