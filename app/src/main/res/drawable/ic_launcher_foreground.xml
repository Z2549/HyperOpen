<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. 外层柔光玻璃圆环背衬 (自发光光晕) -->
    <path
        android:pathData="M54,23 A31,31 0 1,0 54,85 A31,31 0 1,0 54,23 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="23"
                android:startY="23"
                android:endX="85"
                android:endY="85"
                android:startColor="#26FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#05FFFFFF" />
        </aapt:attr>
    </path>

    <!-- 2. 柔光玻璃圆环边缘高光描边 (菲涅尔镜面微光) -->
    <path
        android:pathData="M54,23.5 A30.5,30.5 0 1,0 54,84.5 A30.5,30.5 0 1,0 54,23.5 Z"
        android:strokeWidth="1.2"
        android:strokeAlpha="0.8">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="23"
                android:endX="54"
                android:endY="85"
                android:startColor="#99FFFFFF"
                android:centerColor="#26FFFFFF"
                android:endColor="#40FFFFFF" />
        </aapt:attr>
    </path>

    <!-- 3. 卫星蜂窝浮动微晶粒子 (体现快捷蜂窝展开聚合感) -->
    <!-- 上方微粒子 -->
    <path
        android:pathData="M54,28.5 A2.5,2.5 0 1,0 54,33.5 A2.5,2.5 0 1,0 54,28.5 Z"
        android:fillColor="#80FFFFFF" />
    <!-- 左下微粒子 -->
    <path
        android:pathData="M33,65 A2,2 0 1,0 33,69 A2,2 0 1,0 33,65 Z"
        android:fillColor="#5900F5D4" />
    <!-- 右下微粒子 -->
    <path
        android:pathData="M74,65 A2,2 0 1,0 74,69 A2,2 0 1,0 74,65 Z"
        android:fillColor="#592A82E4" />

    <!-- 4. 核心指纹生物感知晶纹 (高精度圆弧光带，展现现代极简指纹识别感) -->
    <!-- 外层指纹弧 -->
    <path
        android:pathData="M38,58 C38,44.75 45.16,36 54,36 C62.84,36 70,44.75 70,58"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="38"
                android:startY="40"
                android:endX="70"
                android:endY="58"
                android:startColor="#00F5D4"
                android:endColor="#2A82E4" />
        </aapt:attr>
    </path>

    <!-- 中层指纹弧 (右下延伸环抱) -->
    <path
        android:pathData="M43,62 C43,51.5 47.92,43 54,43 C60.08,43 65,51.5 65,62 C65,68.5 60.5,72.5 54,72.5 C48,72.5 45.5,69 45.5,64"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="43"
                android:startY="43"
                android:endX="65"
                android:endY="72"
                android:startColor="#2A82E4"
                android:endColor="#7928CA" />
        </aapt:attr>
    </path>

    <!-- 内层指纹核心弧与极核中心 -->
    <path
        android:pathData="M48.5,60 C48.5,55 50.96,50 54,50 C57.04,50 59.5,55 59.5,60 C59.5,63.5 57,65.5 54,65.5"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="48.5"
                android:startY="50"
                android:endX="59.5"
                android:endY="65.5"
                android:startColor="#7928CA"
                android:endColor="#FF007A" />
        </aapt:attr>
    </path>

    <!-- 5. 中心轻触激活光核 (高亮白紫辉光) -->
    <path
        android:pathData="M54,56 A2,2 0 1,0 54,60 A2,2 0 1,0 54,56 Z"
        android:fillColor="#FFFFFFFF" />
</vector>
